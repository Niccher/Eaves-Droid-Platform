# Environment
.env
.env.backup
.env.production
.env.local

# IDEs & System
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Docker volumes & local data
mysql-data/
*.log

# WebApp (CodeIgniter)
web/vendor/
web/writable/cache/*
!web/writable/cache/.gitkeep
web/writable/debugbar/*
!web/writable/debugbar/.gitkeep
web/writable/logs/*
!web/writable/logs/.gitkeep
!web/writable/logs/index.html
web/writable/session/*
!web/writable/session/.gitkeep
!web/writable/session/index.html
web/writable/uploads/*
!web/writable/uploads/.gitkeep
!web/writable/uploads/index.html
web/writable/exports/*
!web/writable/exports/.gitkeep
web/writable/temp/*
!web/writable/temp/.htaccess
web/writable/reports/*
web/writable/firebase_credentials.json

# ML (Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
ml/build/
ml/develop-eggs/
ml/dist/
ml/downloads/
ml/eggs/
ml/.eggs/
ml/lib/
ml/lib64/
ml/parts/
ml/sdist/
ml/var/
ml/wheels/
ml/*.egg-info/
ml/.installed.cfg
ml/*.egg
ml/.pytest_cache/
ml/.coverage
ml/htmlcov/
ml/.venv/
ml/venv/
ml/ENV/
ml/models_cache/*.joblib
ml/models_cache/*.meta.json
!ml/models_cache/.gitkeep
!ml/models_cache/sms_classifier.joblib
!ml/models_cache/sms_vectorizer.joblib
