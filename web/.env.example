# --------------------------------------------------------------------
# Eaves Droid WebApp — Railway Production Environment Template
# --------------------------------------------------------------------

# Environment: production or development
CI_ENVIRONMENT = production

# Application Base URL (Set to your Railway Public Domain)
# app.baseURL = 'https://eaves-droid-production.up.railway.app/'

# Database Configuration (Mapped dynamically from Railway MySQL Service)
database.default.hostname = ${{MySQL.MYSQLHOST}}
database.default.database = ${{MySQL.MYSQLDATABASE}}
database.default.username = ${{MySQL.MYSQLUSER}}
database.default.password = ${{MySQL.MYSQLPASSWORD}}
database.default.port = ${{MySQL.MYSQLPORT}}
database.default.DBDriver = MySQLi
database.default.DBDebug = false

# Machine Learning API Endpoint (Mapped from ML Eaves Droid Railway Service)
# ML_API_ENDPOINT = 'https://ml-eaves-droid-production.up.railway.app/api/analyze'
# ML_INTERNAL_TOKEN = 'your_production_secret_token_here'

# Session & Security Settings
# app.sessionDriver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
# app.sessionSavePath = 'tbl_sessions'
# security.csrfProtection = 'cookie'

# Admin Account Credentials for Initial Seed
ADMIN_EMAIL = admin@eavesdroid.com
ADMIN_PASSWORD = AdminSecurePass@2026!
SUPERADMIN_EMAIL = superadmin@eavesdroid.com
SUPERADMIN_PASSWORD = SuperAdminSecurePass@2026!
