# ── Runtime ──────────────────────────────────────────────────
LOG_LEVEL=info
CUDA_VISIBLE_DEVICES=-1

# ── Server ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
METRICS_PORT=9090
TF_SERVING_PORT=8501

# ── Model Cache ──────────────────────────────────────────────
MODELS_CACHE=/app/models_cache

# ── Database (shared MySQL with PHP web app) ─────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_eaves_droid
DB_USER=root
DB_PASSWORD=root_password
