# --------------------------------------------------------------------
# ML Eaves Droid Engine — Railway Production Environment Template
# --------------------------------------------------------------------

# Environment: production or development
ENV = production
LOG_LEVEL = info
WORKERS = 2

# Server Configuration
API_HOST = 0.0.0.0
PORT = 9070

# Database Configuration (Shared Railway MySQL Database)
DB_HOST = ${{MySQL.MYSQLHOST}}
DB_PORT = ${{MySQL.MYSQLPORT}}
DB_NAME = ${{MySQL.MYSQLDATABASE}}
DB_USER = ${{MySQL.MYSQLUSER}}
DB_PASSWORD = ${{MySQL.MYSQLPASSWORD}}

# Security & CORS
INTERNAL_TOKEN = your_production_secret_token_here
ALLOWED_ORIGIN = https://eaves-droid-production.up.railway.app
