# ── Runtime ──────────────────────────────────────────────────
LOG_LEVEL=info
CUDA_VISIBLE_DEVICES=-1

# ── Server ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=9070
METRICS_PORT=9073
TF_SERVING_PORT=9072

# ── Model Cache ──────────────────────────────────────────────
MODELS_CACHE=/app/models_cache

# ── Database (shared MySQL with the PHP web app) ─────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_eaves_droid
DB_USER=root
DB_PASSWORD=root_password
