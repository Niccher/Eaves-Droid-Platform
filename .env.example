# =============================================================================
# Eaves Droid Platform - Unified Environment Configuration
# =============================================================================

# --- General & Environment ---
CI_ENVIRONMENT=development
PLATFORM_VERSION=3.0.0
BASE_URL=http://localhost:9007/
GCP_INSTANCE_IP=

# --- Ports ---
WEB_PORT=9007
ML_PORT=9071
DB_PORT_FORWARD=9306
REDIS_PORT_FORWARD=6379

# --- Database ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASS=root_password
DB_NAME=db_eaves_droid

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Inter-Service Security ---
ML_INTERNAL_TOKEN=default_secure_token_change_me_in_prod
ML_LOG_LEVEL=info

# --- Migrations & Automated Seeding ---
RUN_MIGRATIONS=true
